# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for production/shared-core persistence.
# GCP Secret Manager: rz-minetrix-database-url (project rz-mintrix-bos)
# Example local dev: postgresql://rzminetrix:password@localhost:5432/rz_minetrix_dev
DATABASE_URL=""

# RSA_PRIVATE_KEY / RSA_PUBLIC_KEY: Production JWT signing keys (PEM format).
# Required when NODE_ENV=production. Never commit real production keys.
RSA_PRIVATE_KEY=""
RSA_PUBLIC_KEY=""

# ALLOW_EPHEMERAL_JWT_KEYS: Development-only fallback when RSA keys are unset.
# Defaults to allowed in non-production. Set to "false" to require explicit keys in dev.
ALLOW_EPHEMERAL_JWT_KEYS="true"

# CORS_ALLOWED_ORIGINS: Comma-separated allowed browser origins for authenticated API access.
# Required in production. Development defaults to localhost:3000 and localhost:5173.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# SHARED_CORE_TEST_SUITE_SECRET: Authorization key for /api/v1/test/run-suite (min 16 chars).
# Required in production when SHARED_CORE_TEST_SUITE_ENABLED=true.
SHARED_CORE_TEST_SUITE_SECRET=""

# SHARED_CORE_TEST_SUITE_ENABLED: Enable the protected shared-core test suite endpoint.
# Production requires both this flag and SHARED_CORE_TEST_SUITE_SECRET.
# Development is enabled by default unless set to "false".
SHARED_CORE_TEST_SUITE_ENABLED=""

# NODE_ENV: Set to "production" for static asset serving via dist/
NODE_ENV="development"

# PORT: HTTP listen port (default 3000)
PORT="3000"
